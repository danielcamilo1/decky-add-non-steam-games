{
  "name": "add-non-steam-games",
  "version": "1.7.10",
  "description": "Decky Loader plugin to add non-Steam games to your Steam library from Game Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "non-steam-games",
    "shortcuts"
  ],
  "author": "Daniel Vergara",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
